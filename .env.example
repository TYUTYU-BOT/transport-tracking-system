# Configure these before the first API request to a fresh local database.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional locally (a private key is generated outside the repository); required in production.
DRIVER_PII_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Optional locally (a private key is generated outside the repository); required in production.
SMS_ACTIVATION_SECRET=replace-with-base64-encoded-32-byte-key

# Required to send approval and activation codes through Twilio SMS.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# Required for GPS device POST requests to /api/gps.
GPS_DEVICE_TOKEN=replace-with-a-separate-random-device-token

# Optional; defaults to data/transport.sqlite.
# TRANSPORT_DATABASE_PATH=C:/path/to/transport.sqlite
